# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/supportsense
# Alternatively, individual credentials if DATABASE_URL is not provided:
PGHOST=localhost
PGPORT=5432
PGDATABASE=supportsense
PGUSER=growve-a12
PGPASSWORD=

# Session and Cookie Configuration
# Secret key used for signing cookies (at least 32 characters recommended)
COOKIE_SECRET=supportsense_super_secret_cookie_signing_key_32_chars_min!
SESSION_TTL_SECONDS=604800 # 7 days in seconds

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# RAG / Embeddings / Retrieval Configuration
# Provider: 'gemini' (default, produces 768 dims via text-embedding-004), 'openai' (text-embedding-3-small 768 dims), or 'mock'
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY can be used as an alias for GEMINI_API_KEY
GOOGLE_API_KEY=
# OPENAI_API_KEY can be used if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-004
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.3
RETRIEVAL_RRF_K=60

# RAG / LLM Answer Generation Configuration
# Provider: 'gemini' (default, e.g. gemini-1.5-flash), 'openai' (e.g. gpt-4o-mini), or 'mock'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=30000
